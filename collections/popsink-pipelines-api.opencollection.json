                "description": "Filter pipelines by state (e.g., BUILDING, PAUSED)."
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Search term to filter pipelines by name or description."
              },
              {
                "name": "team_id",
                "value": "",
                "type": "query",
                "description": "Filter pipelines by the ID of the team they belong to."
